# Copy to server/.env and fill in.

# Postgres (production / docker-compose). Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql://xhibit:xhibit_dev_password@localhost:5432/xhibit

# Your website's address(es), comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Long random string — protects /api/admin/*. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Any random string — used to hash visitor IPs for rate limiting.
IP_HASH_SALT=change-me

# Optional: instant alert on your phone for every new enquiry.
# 1) Message @BotFather on Telegram → /newbot → copy the token.
# 2) Message your bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Slack / Discord / Make / Zapier incoming-webhook URL.
NOTIFY_WEBHOOK_URL=
